{% assign parts = include.repo.name | split: '/' %}
{% assign stars = include.repo.stars %}
{% assign lang_slug = include.repo.language | downcase | replace: '+', 'p' | replace: ' ', '-' %}

<a class="repo-card" href="https://github.com/{{ include.repo.name }}" title="{{ include.repo.name }}">
  <span class="repo-card-title">
    <span class="repo-card-owner">{{ parts[0] }}/</span>{{ parts[1] }}
  </span>

  {% if include.repo.description %}
    <span class="repo-card-desc">{{ include.repo.description }}</span>
  {% endif %}

  <span class="repo-card-meta">
    {% if include.repo.language %}
      <span class="repo-card-lang">
        <span class="repo-card-dot repo-card-dot-{{ lang_slug }}"></span>
        {{ include.repo.language }}
      </span>
    {% endif %}
    {% if stars %}
      <span class="repo-card-stars">
        <svg viewBox="0 0 16 16" width="1em" height="1em" fill="currentColor" aria-hidden="true">
          <path
            d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"
          ></path>
        </svg>
        {% if stars >= 1000 %}
          {{ stars | divided_by: 100.0 | round | divided_by: 10.0 }}k
        {% else %}
          {{ stars }}
        {% endif %}
      </span>
    {% endif %}
  </span>
</a>
